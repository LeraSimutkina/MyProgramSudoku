<Page x:Class="SudokuEcosystem.Views.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="780" d:DesignWidth="850"
      Title="Судоку Игра">

    <Page.Resources>
        <Style TargetType="Button" x:Key="NumberButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Background" Value="#FFFFC0CB"/>
            <Setter Property="Foreground" Value="#FF4A004A"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FFDB7093"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFC71585"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE6E6FA" Offset="0.0"/>
                <GradientStop Color="#FFFFF0F5" Offset="0.5"/>
                <GradientStop Color="#FFFFE4E1" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#85FFFFFF" Padding="12" Margin="15,15,15,5" CornerRadius="12">
            <Grid>
                <Button Content="⬅ Меню"
                        Style="{StaticResource ActionButton}"
                        Background="#FFDB7093" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="90"
                        Height="35"
                        Click="BackToMenu_Click"/>

                <StackPanel>
                    <Grid MaxWidth="400" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text=" Время: " FontSize="16" VerticalAlignment="Center" FontWeight="Medium" Foreground="#FF4A004A"/>
                            <TextBlock Text="{Binding TimeDisplay}" FontSize="22" FontWeight="Bold" Foreground="#FFC71585" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="❤️" FontSize="24" Margin="1" x:Name="Heart1"/>
                            <TextBlock Text="❤️" FontSize="24" Margin="1" x:Name="Heart2"/>
                            <TextBlock Text="❤️" FontSize="24" Margin="1" x:Name="Heart3"/>
                            <TextBlock Text="❤️" FontSize="24" Margin="1" x:Name="Heart4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content=" Пауза" Style="{StaticResource ActionButton}" Command="{Binding PauseCommand}" Background="#FF9370DB"/>
                        <Button Content=" Новая игра" Style="{StaticResource ActionButton}" Command="{Binding NewGameCommand}" Background="#FFBA55D3"/>
                       
                        <Button Content=" Проверить" Style="{StaticResource ActionButton}" Command="{Binding CheckSolutionCommand}" Background="#FFC71585" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border BorderBrush="#FFC71585" BorderThickness="3.5" CornerRadius="4" Background="White" Margin="20" Padding="1">
                <Grid>
                    <Border BorderBrush="#FFC71585" BorderThickness="1.5" Margin="0"/>
                    <Border Height="3" Background="#FFC71585" VerticalAlignment="Top" Margin="0,135,0,0"/>
                    <Border Height="3" Background="#FFC71585" VerticalAlignment="Top" Margin="0,270,0,0"/>
                    <Border Width="3" Background="#FFC71585" HorizontalAlignment="Left" Margin="135,0,0,0"/>
                    <Border Width="3" Background="#FFC71585" HorizontalAlignment="Left" Margin="270,0,0,0"/>

                    <ItemsControl x:Name="GameBoard" ItemsSource="{Binding Cells}" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0.5" BorderBrush="#FFE6E6FA"
                                                    Width="45" Height="45" Background="{Binding BackgroundColor}">
                                                <TextBox Text="{Binding DisplayValue, Mode=TwoWay}" 
                                                         TextAlignment="Center" FontSize="22" FontWeight="Bold"
                                                         Foreground="{Binding TextColor}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalAlignment="Center"
                                                         IsReadOnly="{Binding IsFixed}"
                                                         PreviewTextInput="OnPreviewTextInput"
                                                         PreviewKeyDown="OnPreviewKeyDown"
                                                         GotFocus="OnCellGotFocus"
                                                         LostFocus="OnCellLostFocus"
                                                         Tag="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#85FFFFFF" Padding="12" Margin="15,5,15,15" CornerRadius="12">
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Button Name="Btn1" Content="1" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn2" Content="2" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn3" Content="3" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn4" Content="4" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn5" Content="5" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn6" Content="6" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn7" Content="7" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn8" Content="8" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>
                    <Button Name="Btn9" Content="9" Style="{StaticResource NumberButton}" Click="NumberButton_Click"/>

                    
                </WrapPanel>

                <TextBlock Text=" Совет: нажмите на ячейку поля, а затем выберите цифру внизу" 
                           FontSize="12" Foreground="#FF8B008B" TextAlignment="Center" FontStyle="Italic" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Border x:Name="PauseOverlay" Grid.RowSpan="3" Background="#95000000" Visibility="Collapsed">
            <Grid>
                <Border Background="#FFFFF0F5" CornerRadius="20" Padding="40" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#FFC71585" BorderThickness="2" Width="320">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.4" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⏸ ИГРА НА ПАУЗЕ" FontSize="24" FontWeight="Black" 
                                   Foreground="#FFC71585" TextAlignment="Center" Margin="0,0,0,25"/>

                        <Button Content="▶ Продолжить" Height="45" Click="ResumeButton_Click" 
                                Background="#FFC71585" Foreground="White" FontSize="16" 
                                FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>