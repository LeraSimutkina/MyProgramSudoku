<Page x:Class="SudokuEcosystem.Views.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аналитика Прогресса"
       Width="850"
  Height="650"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style TargetType="Button" x:Key="AnalyticsActionButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFC71585"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE6E6FA" Offset="0.0"/>
                <GradientStop Color="#FFFFF0F5" Offset="0.5"/>
                <GradientStop Color="#FFFFE4E1" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#85FFFFFF" Padding="12" Margin="15,15,15,5" CornerRadius="12">
            <Grid>
                <Button Content="⬅ Меню" 
                        Style="{StaticResource AnalyticsActionButton}"
                        Background="#FFDB7093" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Width="90" Height="35"
                        Click="BackButton_Click"/>

                <TextBlock Text=" АНАЛИТИКА ПРОГРЕССА" FontSize="24" FontWeight="Black" 
                           Foreground="#FFC71585" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="5" Color="#FFFFB6C1" ShadowDepth="2" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="5,5,5,15" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="650" HorizontalAlignment="Center" Margin="10,10,10,10">

                <TextBlock x:Name="LoadingText" Text="Загрузка статистики..." FontSize="15" 
                           FontWeight="Medium" FontStyle="Italic"
                           HorizontalAlignment="Center" Margin="20" Foreground="#FF8B008B"/>

                <ItemsControl x:Name="StatsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#85FFFFFF" CornerRadius="15" Margin="0,0,0,15" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#FFD8BFD8" ShadowDepth="2" Opacity="0.4"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#FFE6E6FA" Width="52" Height="52" CornerRadius="26" 
                                            BorderBrush="#FFD8BFD8" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Difficulty, StringFormat='Уровень сложности: \{0\}'}" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#FF8B008B" Margin="0,0,0,12"/>

                                        <WrapPanel>
                                            <StackPanel Margin="0,0,25,8">
                                                <TextBlock Text="Всего игр:" FontSize="12" FontWeight="SemiBold" Foreground="#FF778899"/>
                                                <TextBlock Text="{Binding GamesPlayed}" FontSize="16" FontWeight="Black" Foreground="#FF4A004A" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,25,8">
                                                <TextBlock Text="Рекорд очков:" FontSize="12" FontWeight="SemiBold" Foreground="#FF778899"/>
                                                <TextBlock Text="{Binding BestScore}" FontSize="16" FontWeight="Black" Foreground="#FF45B7A0" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,25,8">
                                                <TextBlock Text="Средний счёт:" FontSize="12" FontWeight="SemiBold" Foreground="#FF778899"/>
                                                <TextBlock Text="{Binding AverageScore, StringFormat=\{0:F1\}}" FontSize="16" FontWeight="Black" Foreground="#FF4A004A" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Ср. время решения:" FontSize="12" FontWeight="SemiBold" Foreground="#FF778899"/>
                                                <TextBlock Text="{Binding AverageTime, StringFormat='\{0:F0\} сек'}" FontSize="16" FontWeight="Black" Foreground="#FFC71585" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>