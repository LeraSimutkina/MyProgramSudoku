<Page x:Class="SudokuEcosystem.Views.LeaderboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
       Width="850"
        Height="650"
        
      Title="Таблица лидеров">

    <Page.Resources>
        <Style TargetType="Button" x:Key="LeaderboardActionButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFC71585"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE6E6FA" Offset="0.0"/>
                <GradientStop Color="#FFFFF0F5" Offset="0.5"/>
                <GradientStop Color="#FFFFE4E1" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#85FFFFFF" Padding="12" Margin="15,15,15,10" CornerRadius="12">
            <Grid>
                <Button Content="⬅ Меню"
                        Style="{StaticResource LeaderboardActionButton}"
                        Background="#FFDB7093" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="90"
                        Height="35"
                        Click="BackButton_Click"/>

                <TextBlock Text=" ТАБЛИЦА ЛИДЕРОВ" 
                           FontSize="24" 
                           FontWeight="Black" 
                           Foreground="#FFC71585" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#85FFFFFF" CornerRadius="15" Margin="15,5,15,20" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" Color="#FFD8BFD8" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>

            <DataGrid x:Name="LeaderboardGrid" AutoGenerateColumns="False" 
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#20FFC0CB"
                      FontSize="14" HeadersVisibility="Column" IsReadOnly="True"
                      GridLinesVisibility="None" HorizontalGridLinesBrush="#FFD8BFD8">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFE6E6FA"/>
                        <Setter Property="Foreground" Value="#FF4A004A"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="#FFDB7093"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFFFC0CB"/>
                                <Setter Property="Foreground" Value="#FF4A004A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header=" Место" Binding="{Binding Rank}" Width="90"/>
                    <DataGridTextColumn Header=" Игрок" Binding="{Binding PlayerName}" Width="1.5*"/>
                    <DataGridTextColumn Header=" Сложность" Binding="{Binding Difficulty}" Width="1.2*"/>
                    <DataGridTextColumn Header=" Очки" Binding="{Binding Score}" Width="1*"/>
                    <DataGridTextColumn Header=" Время" Binding="{Binding CompletionTime}" Width="1.2*"/>
                    <DataGridTextColumn Header=" Дата" Binding="{Binding CompletedAt}" Width="1.5*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>
    </Grid>
</Page>