<Window x:Class="SudokuEcosystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Sudoku" Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFF0F5"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF4A004A"/>
            <Setter Property="Margin" Value="5,5,0,2"/>
        </Style>

        <Style TargetType="Control" x:Key="RoundedInput">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD8BFD8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE6E6FA" Offset="0.0"/>
                <GradientStop Color="#FFFFF0F5" Offset="0.5"/>
                <GradientStop Color="#FFFFE4E1" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#85FFFFFF" CornerRadius="15" Margin="25" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#FFDB7093" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="🌸 SUDOKU 🌸" FontSize="26" FontWeight="Black" 
                               Foreground="#FFC71585" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" Color="#FFFFB6C1" ShadowDepth="2" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Добро пожаловать в игру" FontSize="12" FontStyle="Italic" 
                               Foreground="#FF8B008B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Логин" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2" x:Name="LoginBox" Style="{StaticResource RoundedInput}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox Grid.Row="4" x:Name="PasswordBox" Style="{StaticResource RoundedInput}" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,5">
                    <Button x:Name="LoginBtn" Content="Войти" Width="110" Height="38" 
                            Margin="6" Click="LoginBtn_Click"
                            Background="#FFC71585" Foreground="White" FontSize="14" FontWeight="Bold" 
                            Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="6" Color="#FFC71585" ShadowDepth="1" Opacity="0.4"/>
                        </Button.Effect>
                    </Button>

                    <Button x:Name="RegisterBtn" Content="Регистрация" Width="110" Height="38" 
                            Margin="6" Click="RegisterBtn_Click"
                            Background="#FFE6E6FA" Foreground="#FF4B0082" FontSize="13" FontWeight="SemiBold" 
                            Cursor="Hand" BorderBrush="#FF9370DB" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>